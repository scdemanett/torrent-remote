<component type="desktop-application">
  <id>io.github.scdemanett.torrent-remote</id>
  <name>Torrent Remote</name>
  <summary>Remote control for Transmission</summary>
  <developer id="io.github.scdemanett">
    <name>Steven Demanett</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <url type="homepage">https://github.com/scdemanett/torrent-remote</url>
  <url type="bugtracker">https://github.com/scdemanett/torrent-remote/issues</url>
  <url type="vcs-browser">https://github.com/scdemanett/torrent-remote</url>
  <url type="contribute">https://github.com/scdemanett/torrent-remote/blob/main/CONTRIBUTING.md</url>

  <description>
    <p>
      Torrent Remote manages a Transmission torrent daemon running on the same
      machine or on any other host that exposes the Transmission RPC endpoint.
      It is a fork of TrguiNG.
    </p>
    <p>Features:</p>
    <ul>
      <li>Multi-tabbed interface for concurrent server connections</li>
      <li>Torrent creation with fast multi-threaded hashing</li>
      <li>Powerful torrent filtering options</li>
      <li>Support for the latest Transmission features: labels, bandwidth groups, sequential download</li>
      <li>Notifications and a sound when a download completes, and a tray icon</li>
      <li>Light and dark themes, or follow the system setting</li>
    </ul>
    <p>Transmission 2.40 or later is required.</p>
  </description>

  <launchable type="desktop-id">Torrent Remote.desktop</launchable>

  <branding>
    <color type="primary" scheme_preference="light">#36d9f3</color>
    <color type="primary" scheme_preference="dark">#1696aa</color>
  </branding>

