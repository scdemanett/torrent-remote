{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "template": "installer.nsi"
      }
    },
    "publisher": "Steven Demanett",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "dbip.mmdb"
    ],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Transmission torrent daemon remote GUI",
    "longDescription": "Remote control GUI for Transmission torrent daemon",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "",
      "exceptionDomain": "",
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ],
        "desktopTemplate": "app.desktop",
        "files": {
          "/usr/share/metainfo/io.github.scdemanett.torrent-remote.metainfo.xml": "io.github.scdemanett.torrent-remote.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/torrent-remote.svg": "icons/app.svg",
          "/usr/share/icons/hicolor/512x512/apps/torrent-remote.png": "icons/icon.png"
        }
      },
      "rpm": {
        "epoch": 0,
        "files": {
          "/usr/share/metainfo/io.github.scdemanett.torrent-remote.metainfo.xml": "io.github.scdemanett.torrent-remote.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/torrent-remote.svg": "icons/app.svg",
          "/usr/share/icons/hicolor/512x512/apps/torrent-remote.png": "icons/icon.png"
        },
        "release": "1",
        "depends": [
          "alsa-lib"
        ],
        "desktopTemplate": "app.desktop"
      }
    },
    "licenseFile": "../LICENSE.txt",
    "license": "GNU-AGPL-3.0",
    "createUpdaterArtifacts": true
  },
  "build": {
    "beforeBuildCommand": "npm run webpack-prod",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run webpack-serve",
    "devUrl": "http://localhost:8787/"
  },
  "productName": "Torrent Remote",
  "mainBinaryName": "torrent-remote",
  "version": "2.2.1",
  "identifier": "io.github.scdemanett.torrentremote",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMjBGREMzMDVBODZFNjUKUldSbGJxZ0Z3LzBnTVZxd3E4TzVlM0drYlVjTW5LbWxJRVZaZ1BQU3ZIckFEeUJsZ1l5UkRaZEkK",
      "endpoints": [
        "https://github.com/scdemanett/torrent-remote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "cli": {
      "description": "Torrent Remote - Remote control GUI for the Transmission torrent daemon",
      "args": [
        {
          "name": "torrent",
          "index": 1,
          "multiple": true,
          "takesValue": true,
          "description": "torrent file or magnet link url"
        },
        {
          "name": "start-minimized",
          "description": "start in the tray with the window hidden (used by Launch on startup)"
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'self'"
    }
  }
}
